# Copia este archivo como ".env" y cambia JWT_SECRET por una frase tuya y única.
PORT=3000
# Firma las sesiones. Debe ser larga (32 caracteres o más) y secreta: quien la
# conozca podría hacerse pasar por cualquier cuenta. Para generar una:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_frase_secreta_larga_y_unica

# El email que se registre con este correo será administrador de la academia.
ADMIN_EMAIL=admin@academia.com

# URL pública de la app. Se usa en los enlaces de los emails (recuperar la
# contraseña) y en la vuelta desde Stripe. En local, http://localhost:3000.
FRONTEND_URL=http://localhost:3000

# --- Pagos con tarjeta (OPCIONAL) ---
# Sin estas dos claves la app funciona igual, pero solo con pago en recepción.
# Usa SIEMPRE claves de PRUEBA (sk_test_...) hasta haberlo probado todo.
STRIPE_SECRET_KEY=
# Secreto para verificar los avisos de Stripe. En local lo da "stripe listen".
STRIPE_WEBHOOK_SECRET=

# Modo demostración del pago con tarjeta. Sin STRIPE_SECRET_KEY, las familias
# VEN la opción de pagar con tarjeta, pero al usarla solo sale un aviso de
# "próximamente": no se cobra ni se crea nada. Sirve para PRESENTAR la app.
# Ponlo a 1 solo para enseñarla; déjalo en 0 cuando la usen alumnos reales
# (verían un botón de tarjeta que no hace nada).
# Si se pone STRIPE_SECRET_KEY, la clave manda y esto se ignora.
STRIPE_DEMO=0

# --- Datos de ejemplo ---
# 1 (o sin poner): la primera vez que arranca con una base de datos vacía, crea
# una academia de ejemplo (disciplinas, clases, familias y cuentas de prueba).
# 0: arranca VACÍA. Es lo que hay que usar para la academia real: después te
# registras con el email de ADMIN_EMAIL y lo montas todo desde Administración.
# Nunca toca una base de datos que ya tiene datos.
SEED_DEMO_DATA=1

# --- Fotos de perfil (OPCIONAL) ---
# Carpeta donde se guardan las fotos. Por defecto, backend/uploads. En el
# servidor definitivo conviene que esté en un disco que no se borre al
# actualizar la app.
# UPLOADS_DIR=

# --- Emails (OPCIONAL) ---
# Sin configurar (modo local), los emails NO salen: se guardan en
# Administración → Emails, donde se pueden leer. Sirve para probar y enseñar
# la app. Para enviarlos de verdad con Brevo (tiene plan gratuito):
#   1. Crea una cuenta en brevo.com y verifica el remitente (o el dominio).
#   2. Crea una clave de API (SMTP & API → API Keys).
#   3. Rellena estas cuatro líneas y reinicia la app.
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=
# EMAIL_FROM=avisos@tu-dominio.es
# EMAIL_FROM_NAME=Nombre de la academia

# --- Copias de seguridad ---
# La app hace una copia diaria de la base de datos (y de las fotos) y guarda
# las BACKUP_KEEP más recientes. Por defecto, en backend/backups y 14 copias.
# Además, descarga alguna desde Administración → Academia y guárdala FUERA del
# ordenador donde funciona la app.
# BACKUP_DIR=
# BACKUP_KEEP=14

# --- Solo al publicarla en Internet ---
# Detrás de un proxy (Caddy, Nginx...) que pone el HTTPS: TRUST_PROXY=1, para
# que la app vea la IP real de cada visitante (límite de intentos de acceso) y
# sepa que la conexión es segura.
# TRUST_PROXY=1
# Solo si el frontend se sirve desde OTRO dominio distinto al de la API (no es
# lo normal: la app sirve las dos cosas). Ejemplo: https://app.academia.es
# CORS_ORIGIN=

# Solo para la demo pública del portfolio (Render): cinta con las cuentas de
# prueba y cambios de contraseña bloqueados. En tu ordenador, déjalo sin poner.
# DEMO=1
